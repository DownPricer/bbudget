# Base de données (local)
DATABASE_URL="postgresql://bbudget:bbudget@localhost:5432/bbudget?schema=public"
POSTGRES_USER=bbudget
POSTGRES_PASSWORD=change-moi-en-prod
POSTGRES_DB=bbudget

# Port Next.js (dev / docker)
PORT=3000

# Domaine public (Caddy HTTPS en prod)
DOMAIN=budget.exemple.com

# Auth.js — générer avec : openssl rand -base64 32
AUTH_SECRET="remplace-moi-par-un-secret-long-et-aleatoire"
AUTH_TRUST_HOST=true

# URL publique de l'appli
AUTH_URL="http://localhost:3000"

# Inscription publique (laisser false après création du compte)
ALLOW_SIGNUP=false

# Seed interdit si false ; aussi bloqué quand NODE_ENV=production
ALLOW_SEED=true

# Compte de démo (utilisé par npm run db:seed — valeurs factices locales)
SEED_EMAIL="demo@bbudget.app"
SEED_PASSWORD="demo1234"
SEED_FIRST_NAME="Léa"
